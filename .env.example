# MoveInSync HR Roster Sync Environment Configuration
# Copy this file to .env and adjust variables for your local deployment.

# Environment
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Application Server
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL 16)
# Async URL used by FastAPI / AsyncEngine
DATABASE_URL=postgresql+asyncpg://postgres:test@162741@localhost:5433/moveinsync_roster

DATABASE_SYNC_URL=postgresql+psycopg://postgres:test@162741@localhost:5433/moveinsync_roster

# Database Connection Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Security & Authentication
JWT_SECRET_KEY=dev-secret-key-change-in-production-min-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Idempotency Configuration
IDEMPOTENCY_RETENTION_DAYS=7

# Nightly Reconciliation & Safety Brake Settings
SAFETY_BRAKE_THRESHOLD_PERCENT=30.0
RECONCILIATION_CHUNK_SIZE=2000

# Transactional Outbox Publisher Settings
OUTBOX_POLL_INTERVAL_SECONDS=1.0
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_RETRIES=5
OUTBOX_BASE_BACKOFF_SECONDS=1.0

# Downstream Service URLs / Mock Settings
DOWNSTREAM_BOOKING_SERVICE_URL=http://localhost:8000/api/v1/mock-downstream/cancel-booking
DOWNSTREAM_TIMEOUT_SECONDS=5.0

# Cache Configuration
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=1000
